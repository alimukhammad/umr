# Web app URL of the Google Apps Script in apps-script/ (ends in /exec).
# Leave empty to hide the email sign-up.
VITE_REMINDER_ENDPOINT=

# Life Emoji (manual codes). Leave any of these empty to hide its button.
# Payme or Click payment link buyers pay through:
VITE_PAYMENT_URL=
# Where buyers ask for their code:
VITE_ORDER_EMAIL=
VITE_ORDER_TELEGRAM=
# One-time price in so'm:
VITE_EMOJI_PRICE_UZS=50000
